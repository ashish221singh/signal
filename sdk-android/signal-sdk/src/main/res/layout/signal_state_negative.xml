<?xml version="1.0" encoding="utf-8"?>
<!--
  Signal NEGATIVE state (Task E.4).
  A prompt, a single-select ChipGroup the fragment fills with one Chip per
  config.chips_on_negative entry, an "Other" affordance that routes to the
  OTHER sub-branch, and a full-width primary Submit button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signal_negative_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/signal_space_2"
    android:paddingBottom="@dimen/signal_space_2">

    <TextView
        android:id="@+id/signal_negative_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/signal_negative_prompt"
        android:textSize="@dimen/signal_text_body"
        android:textStyle="bold"
        android:textColor="@color/signal_ink" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/signal_negative_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/signal_space_3"
        app:singleSelection="true"
        app:selectionRequired="false"
        app:chipSpacingHorizontal="@dimen/signal_space_2"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <Button
        android:id="@+id/signal_negative_other"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/signal_space_2"
        android:minHeight="@dimen/signal_touch_target"
        android:text="@string/signal_negative_other"
        android:textColor="@color/signal_link" />

    <Button
        android:id="@+id/signal_negative_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/signal_space_4"
        android:minHeight="@dimen/signal_touch_target"
        android:text="@string/signal_submit"
        android:textColor="@color/signal_action_ink"
        android:backgroundTint="@color/signal_action" />
</LinearLayout>
