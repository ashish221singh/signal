{
  "name": "@signal/web-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/web-core.mjs",
  "module": "./dist/web-core.mjs",
  "types": "./dist/web-core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/web-core.d.ts",
      "import": "./dist/web-core.mjs"
    },
    "./bundle": "./dist/web-core.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "size": "node scripts/size-check.mjs",
    "typecheck": "tsc --noEmit",
    "posttypecheck": "node ../tokens/scripts/generate.mjs && tsup && node scripts/size-check.mjs"
  },
  "dependencies": {
    "@signal/contracts": "workspace:*",
    "@signal/tokens": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "happy-dom": "^15.11.7",
    "tsup": "^8.3.5"
  }
}
