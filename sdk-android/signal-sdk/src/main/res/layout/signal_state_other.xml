<?xml version="1.0" encoding="utf-8"?>
<!--
  Signal OTHER sub-branch (Task E.4).
  A free-text input, an optional "Add photo" affordance (shown only when
  config.other_allows_image), and a full-width primary Submit button. When
  config.other_requires_text the fragment keeps Submit disabled until the text
  is non-empty.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/signal_other_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/signal_space_2"
    android:paddingBottom="@dimen/signal_space_2">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:hint="@string/signal_other_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/signal_other_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/signal_other_text_min_height"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:textColor="@color/signal_ink" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/signal_add_photo"
        style="?attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/signal_space_2"
        android:minHeight="@dimen/signal_touch_target"
        android:text="@string/signal_add_photo"
        android:textColor="@color/signal_link"
        android:visibility="gone" />

    <Button
        android:id="@+id/signal_other_submit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/signal_space_4"
        android:minHeight="@dimen/signal_touch_target"
        android:text="@string/signal_submit"
        android:textColor="@color/signal_action_ink"
        android:backgroundTint="@color/signal_action" />
</LinearLayout>
