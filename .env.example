# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Postgres (docker compose up -d). Wired into the API in Milestone 1.
DATABASE_URL=postgresql://signal:signal_local_dev@localhost:5433/signal

# Local S3-compatible storage (MinIO via docker compose up -d).
# Used by the SDK image-upload endpoint. In production, S3_ACCESS_KEY and
# S3_SECRET_KEY are required; the rest fall back to these defaults.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=signal-feedback-images
S3_ACCESS_KEY=signal
S3_SECRET_KEY=signal_local_dev
S3_PUBLIC_URL=http://localhost:9000/signal-feedback-images

# SESSION_SECRET signs the console session cookie. Defaults to a dev constant in
# development; REQUIRED (min 16 chars, from a secrets manager) in production.
# SESSION_SECRET=

# SDK auth is now per-account publishable keys (pk_live_* / pk_test_*), issued at
# signup and stored in the api_keys table — there is no global app-key env var.
# Bootstrap a dev account + key with: pnpm --filter @signal/api seed

# ── Agentic backend (B3) ──
# PUBLIC_BASE_URL is the base for the device-flow verification URI and hosted
# links. Defaults to localhost in dev; REQUIRED in production (B4-D4).
# PUBLIC_BASE_URL=http://localhost:3000
#
# ALLOW_PASSWORD_CLI_LOGIN gates the interim password→CLI-token login
# (POST /v1/cli/login). Default ON in dev/test, OFF in production so the device
# flow is the only prod path. Set to true/false to override.
# ALLOW_PASSWORD_CLI_LOGIN=true
#
# ── Reporting / hardening (B4) ──
# CONSOLE_ORIGINS is the comma-separated allow-list of dashboard origins allowed
# to make credentialed cross-origin calls to /v1/console/* (B4-D2). Defaults to
# the localhost dev origins (Vite :5173 + :3000); REQUIRED in production (B4-D4).
# CONSOLE_ORIGINS=https://app.yourdomain.com
#
# Production-required env set (B4-D4): DATABASE_URL, SESSION_SECRET,
# S3_ACCESS_KEY, S3_SECRET_KEY, PUBLIC_BASE_URL, CONSOLE_ORIGINS. The rest fall
# back to safe defaults. Liveness is GET /health (always 200); readiness is
# GET /ready (deep DB check → 503 if the DB is down; S3 best-effort).
#
# CLI / MCP client config (packages/cli, packages/mcp):
# SIGNAL_API_URL=http://localhost:3000   # API base URL the CLI/MCP talk to
# SIGNAL_TOKEN=cli_...                    # CLI token for the MCP server
# SIGNAL_CONFIG_DIR=~/.signal            # CLI credential directory override
