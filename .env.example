# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local Postgres (docker compose up -d). Wired into the API in Milestone 1.
DATABASE_URL=postgresql://signal:signal_local_dev@localhost:5433/signal

# Local S3-compatible storage (MinIO via docker compose up -d).
# Used by the SDK image-upload endpoint. In production, S3_ACCESS_KEY and
# S3_SECRET_KEY are required; the rest fall back to these defaults.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=signal-feedback-images
S3_ACCESS_KEY=signal
S3_SECRET_KEY=signal_local_dev
S3_PUBLIC_URL=http://localhost:9000/signal-feedback-images

# SESSION_SECRET signs the console session cookie. Defaults to a dev constant in
# development; REQUIRED (min 16 chars, from a secrets manager) in production.
# SESSION_SECRET=

# SDK auth is now per-account publishable keys (pk_live_* / pk_test_*), issued at
# signup and stored in the api_keys table — there is no global app-key env var.
# Bootstrap a dev account + key with: pnpm --filter @signal/api seed
