<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- ============================================================= -->
  <!-- Signal theme (DayNight so values-night colors apply for free). -->
  <!-- The native sheet is gone (F2 refit); the sheet now renders in a -->
  <!-- WebView hosting the bundled web-core, which carries its own      -->
  <!-- (inlined-token) styling. This base theme is kept for the host    -->
  <!-- Activity/container and the design-token color palette below.     -->
  <!-- ============================================================= -->
  <style name="Theme.Signal" parent="Theme.Material3.DayNight.NoActionBar">
    <item name="colorPrimary">@color/signal_orange_500</item>
    <item name="colorOnPrimary">@color/signal_action_ink</item>
    <item name="colorSecondary">@color/signal_blue_700</item>
    <item name="colorOnSecondary">@color/signal_action_ink</item>
    <item name="colorSurface">@color/signal_bg</item>
    <item name="android:colorBackground">@color/signal_bg</item>
    <item name="colorOnSurface">@color/signal_ink</item>
    <item name="colorOnSurfaceVariant">@color/signal_ink_secondary</item>
    <item name="colorOutline">@color/signal_line</item>
    <item name="colorError">@color/signal_danger</item>
  </style>

  <!-- Transparent dialog theme hosting the WebView sheet: no dim/frame so the -->
  <!-- web-core sheet (its own backdrop + card) is the only visible chrome. -->
  <style name="Theme.Signal.WebSheetDialog" parent="Theme.Material3.DayNight.Dialog">
    <item name="android:windowBackground">@android:color/transparent</item>
    <item name="android:windowIsFloating">false</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:backgroundDimEnabled">false</item>
  </style>
</resources>
