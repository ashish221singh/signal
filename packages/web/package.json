{
  "name": "@ashish221/signal-web",
  "version": "0.1.2",
  "type": "module",
  "description": "Signal Web SDK — one-tap in-app feedback (CSAT). Signal.init + Signal.track.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./outbox": {
      "types": "./dist/outbox.d.ts",
      "import": "./dist/outbox.js",
      "require": "./dist/outbox.cjs"
    },
    "./suppression": {
      "types": "./dist/suppression.d.ts",
      "import": "./dist/suppression.js",
      "require": "./dist/suppression.cjs"
    },
    "./webHost": {
      "types": "./dist/webHost.d.ts",
      "import": "./dist/webHost.js",
      "require": "./dist/webHost.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup"
  },
  "dependencies": {},
  "devDependencies": {
    "@signal/contracts": "workspace:*",
    "@signal/web-core": "workspace:*",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^15.11.7",
    "tsup": "^8.5.1"
  }
}
